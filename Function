Add two numbers using function with argument and return type

#include <stdio.h>

int add (int a, int b)

{

return a+b;

}

int main()

{

int a, b, sum;

printf("Enter two numbers: ");

scanf ("%d %d", &a, &b);

sum add (a, b);

printf ("Sum = %d", sum);

return 0;

}

Output:

Enter two numbers: 10 20

Sum = 30
